{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main",
    "v2"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in images.yaml (CIVITAS/CORE 2 add-on layout, branch v2).",
      "managerFilePatterns": [
        "/^images\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<depName>[^\\s'\"]+)['\"]?\\s*\\n\\s*tag:\\s*['\"]?(?<currentValue>[^'\"\\n]+)['\"]?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track ghcr.io/jandaroscher/cividash-app + cividash-web images declared in vars/software_references.yml (CIVITAS/CORE 1 layout, branch main).",
      "managerFilePatterns": [
        "/^vars/software_references\\.yml$/"
      ],
      "matchStrings": [
        "registry:\\s*\"(?<registryUrl>[^\"]+)\"\\s*\\n\\s*repository:\\s*\"(?<depName>[^\"]+)\"\\s*\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://{{{registryUrl}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "jandaroscher/cividash-app",
        "jandaroscher/cividash-web",
        "ghcr.io/jandaroscher/cividash-app",
        "ghcr.io/jandaroscher/cividash-web"
      ],
      "groupName": "CiviDash add-on images"
    }
  ]
}
