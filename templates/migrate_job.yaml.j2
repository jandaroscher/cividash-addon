# =============================================================================
# Job: cividash-migrate — runs Laravel database migrations
# -----------------------------------------------------------------------------
# Image: cividash_app (php-fpm, full app).
# Entrypoint overridden to ["php","artisan"] + args ["migrate","--force"] so the
# image's default cache-warmer entrypoint is bypassed and only migrations run.
# Env: app config from cividash-app-secret (envFrom) + DB credentials from
# cividash-db-secret via secretKeyRef (DB_DATABASE/DB_USERNAME/DB_PASSWORD).
# =============================================================================
apiVersion: batch/v1
kind: Job
metadata:
  name: cividash-migrate
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-migrate
    app.kubernetes.io/part-of: cividash
spec:
  backoffLimit: 3
  # Clean up the finished Job automatically after 1h to avoid clutter on re-runs.
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-migrate
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        # cividash_app runs as alpine www-data (uid 82).
        runAsUser: 82
        runAsGroup: 82
        fsGroup: 82
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "{{ cividash_app_image }}"
          imagePullPolicy: Always
          # Bypass the cache-warmer entrypoint: run artisan migrate directly.
          command: ["php", "artisan"]
          args: ["migrate", "--force"]
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          # Non-DB app env (incl. APP_KEY) from cividash-app-secret + OIDC/CIVITAS env.
          envFrom:
            - secretRef:
                name: cividash-app-secret
            - secretRef:
                name: cividash-oidc-secret
          # DB credentials single-sourced from cividash-db-secret.
          env:
            - name: DB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_DATABASE
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_USER
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_PASSWORD
          # Per-pod writable paths (read-only image; Laravel needs these dirs).
          volumeMounts:
            - name: storage-framework
              mountPath: /var/www/html/storage/framework
            - name: bootstrap-cache
              mountPath: /var/www/html/bootstrap/cache
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 512Mi
      volumes:
        - name: storage-framework
          emptyDir: {}
        - name: bootstrap-cache
          emptyDir: {}
