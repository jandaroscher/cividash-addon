# =============================================================================
# Job: cividash-migrate — runs Laravel database migrations
# -----------------------------------------------------------------------------
# Image: cividash_app (php-fpm, full app).
# Entrypoint overridden to ["php","artisan"] + args ["migrate","--force"] so the
# image's default cache-warmer entrypoint is bypassed and only migrations run.
# Env: app config from cividash-app-secret (envFrom) + the external-Postgres
# connection from cividash-db-secret via envFrom (DB_CONNECTION/HOST/PORT/DATABASE/
# USERNAME/PASSWORD).
# =============================================================================
apiVersion: batch/v1
kind: Job
metadata:
  name: cividash-migrate
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-migrate
    app.kubernetes.io/part-of: cividash
spec:
  backoffLimit: 3
  # Clean up the finished Job automatically after 1h to avoid clutter on re-runs.
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-migrate
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        # cividash_app runs as alpine www-data (uid 82).
        runAsUser: 82
        runAsGroup: 82
        fsGroup: 82
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "{{ cividash_app_image }}"
          imagePullPolicy: {{ cividash_image_pull_policy | default('Always') }}
          # Bypass the cache-warmer entrypoint: run artisan migrate directly.
          command: ["php", "artisan"]
          args: ["migrate", "--force"]
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          # Non-DB app env (incl. APP_KEY) from cividash-app-secret + OIDC/CIVITAS env,
          # plus the full external-Postgres connection from cividash-db-secret
          # (DB_CONNECTION/HOST/PORT/DATABASE/USERNAME/PASSWORD).
          envFrom:
            - secretRef:
                name: cividash-app-secret
            - secretRef:
                name: cividash-oidc-secret
            - secretRef:
                name: cividash-db-secret
          # Per-pod writable paths (read-only image; Laravel needs these dirs).
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 512Mi
