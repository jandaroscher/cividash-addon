# =============================================================================
# StatefulSet: cividash-db — MariaDB 11
# -----------------------------------------------------------------------------
# R1 NOTICE — MariaDB is NOT a CORE-native convention.
#   CORE is Postgres-only and provisions databases via the Zalando Postgres
#   operator (with operator-managed backups). This add-on instead ships MariaDB
#   as a plain StatefulSet + PersistentVolumeClaim with NO operator, NO automated
#   backup, and NO Velero integration. This is a deliberate, documented gap and
#   an OPEN POLICY QUESTION with the CORE team. Postgres remains the documented
#   alternative if/when the dashboard is ported.
#
# MANUAL BACKUP NOTE:
#   There is no automated backup. Operators MUST take manual dumps, e.g.:
#     kubectl -n {{ k8s_namespace }} exec cividash-db-0 -- \
#       sh -c 'mariadb-dump -u root -p"$MARIADB_ROOT_PASSWORD" --single-transaction \
#              --all-databases' > cividash-db-backup-$(date +%F).sql
#   Store dumps off-cluster. The PVC (cividash-db-data) is the only persistence; if it
#   is lost without a dump, the data is gone.
# =============================================================================
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: cividash-db
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-db
    app.kubernetes.io/part-of: cividash
spec:
  serviceName: cividash-db
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cividash-db
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-db
        app.kubernetes.io/part-of: cividash
    spec:
      securityContext:
        runAsNonRoot: true
        # mariadb:11 (the official image) runs as the "mysql" user, uid 999.
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: mariadb
          image: "mariadb:11"
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          ports:
            - name: mysql
              containerPort: 3306
              protocol: TCP
          # Bootstrap credentials come straight from cividash-db-secret.
          envFrom:
            - secretRef:
                name: cividash-db-secret
          volumeMounts:
            - name: cividash-db-data
              mountPath: /var/lib/mysql
          # Liveness/readiness via the image's bundled healthcheck.sh (mariadb-admin ping).
          readinessProbe:
            exec:
              command:
                - healthcheck.sh
                - --connect
                - --innodb_initialized
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            exec:
              command:
                - healthcheck.sh
                - --connect
                - --innodb_initialized
            initialDelaySeconds: 30
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
  volumeClaimTemplates:
    - metadata:
        name: cividash-db-data
        labels:
          app.kubernetes.io/name: cividash-db
          app.kubernetes.io/part-of: cividash
      spec:
        accessModes:
          - ReadWriteOnce
{% if inv_k8s.storage_class is defined and inv_k8s.storage_class.loc is defined %}
        storageClassName: "{{ inv_k8s.storage_class.loc }}"
{% endif %}
        resources:
          requests:
            storage: "{{ inv_addons.cividash.db.storage | default('5Gi') }}"
