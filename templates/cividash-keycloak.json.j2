{# ---------------------------------------------------------------------------
   Keycloak client JSON for the cividash add-on.

   https://<admin_host|public_host>/admin/auth/keycloak/callback. APISIX does
   not consume this client; admin auth is enforced by the app.

   The NGSI-LD machine token is not issued by this client: it
   comes from the shared operator-provided "api-access" client, provisioned in

   Confidential client (publicClient=false, client-secret authenticator).
   Direct access grants (password grant) are intentionally disabled.

   Sane defaults are mirrored from airflow-keycloak.json.j2 in the CIVITAS/CORE
   deployment repo.
--------------------------------------------------------------------------- #}
{
    "clientId": "{{ cividash_oidc_client_id }}",
    "name": "CiviDash",
    "description": "This client was created by ansible (cividash add-on). Used by the CiviDash app for Socialite admin SSO (auth-code). The NGSI-LD machine token is issued by the shared api-access client.",
    "rootUrl": "https://{{ inv_addons.cividash.admin_host | default(inv_addons.cividash.public_host) }}",
    "baseUrl": "https://{{ inv_addons.cividash.admin_host | default(inv_addons.cividash.public_host) }}/admin",
    "adminUrl": "https://{{ inv_addons.cividash.admin_host | default(inv_addons.cividash.public_host) }}",
    "surrogateAuthRequired": false,
    "enabled": true,
    "alwaysDisplayInConsole": false,
    "clientAuthenticatorType": "client-secret",
    "redirectUris": [
        "https://{{ inv_addons.cividash.admin_host | default(inv_addons.cividash.public_host) }}/admin/auth/keycloak/callback"
    ],
    "webOrigins": [
        "https://{{ inv_addons.cividash.admin_host | default(inv_addons.cividash.public_host) }}"
    ],
    "notBefore": 0,
    "bearerOnly": false,
    "consentRequired": false,
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "publicClient": false,
    "frontchannelLogout": false,
    "protocol": "openid-connect",
    "attributes": {
        "saml.assertion.signature": "false",
        "saml.multivalued.roles": "false",
        "saml.force.post.binding": "false",
        "saml.encrypt": "false",
        "login_theme": "{{ inv_access.keycloak.theme }}",
        "backchannel.logout.revoke.offline.tokens": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "backchannel.logout.session.required": "true",
        "client_credentials.use_refresh_token": "false",
        "saml_force_name_id_format": "false",
        "saml.client.signature": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "saml.authnstatement": "false",
        "display.on.consent.screen": "false",
        "saml.onetimeuse.condition": "false"
    },
    "authenticationFlowBindingOverrides": {},
    "fullScopeAllowed": true,
    "nodeReRegistrationTimeout": -1,
    "protocolMappers": [
        {
            "name": "Role-Group mapping",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
                "multivalued": "true",
                "userinfo.token.claim": "true",
                "id.token.claim": "true",
                "access.token.claim": "true",
                "claim.name": "groups",
                "usermodel.clientRoleMapping.clientId": "{{ cividash_oidc_client_id }}"
            }
        },
        {
            "name": "cividash-audience",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "{{ cividash_oidc_client_id }}",
                "id.token.claim": "false",
                "access.token.claim": "true",
                "introspection.token.claim": "true",
                "included.custom.audience": "{{ cividash_oidc_client_id }}"
            }
        }
    ],
    "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email",
        "openid"
    ],
    "optionalClientScopes": [
    ],
    "access": {
        "view": true,
        "configure": true,
        "manage": true
    }
}
