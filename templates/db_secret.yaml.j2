# =============================================================================
# Secret: cividash-db-secret — MariaDB bootstrap credentials
# -----------------------------------------------------------------------------
# Consumed by:
#   - StatefulSet cividash-db  : envFrom (MARIADB_* bootstrap variables)
#   - Deployments / Job    : DB_DATABASE/DB_USERNAME/DB_PASSWORD via secretKeyRef
# Values are resolved idempotently in tasks/secrets.yml (passwords preserved across runs).
# =============================================================================
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: cividash-db-secret
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-db
    app.kubernetes.io/part-of: cividash
data:
  MARIADB_DATABASE: "{{ cividash_db_database | b64encode }}"
  MARIADB_USER: "{{ cividash_db_user | b64encode }}"
  MARIADB_PASSWORD: "{{ cividash_db_password | b64encode }}"
  MARIADB_ROOT_PASSWORD: "{{ cividash_db_root_password | b64encode }}"
