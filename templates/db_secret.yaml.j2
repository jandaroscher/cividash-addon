# =============================================================================
# Secret: cividash-db-secret — external PostgreSQL connection
# -----------------------------------------------------------------------------
# Single source of truth for the app's database connection. The add-on does NOT
# run a database server itself; it connects to an EXTERNALLY provisioned Postgres
# whose host/database/user/password are supplied by the operator/CORE via the
# role vars (vars/default.yml, overridable from the platform inventory).
#
# Consumed by cividash-fpm / cividash-queue / cividash-scheduler / cividash-migrate via
# `envFrom: secretRef: cividash-db-secret`, so all six DB_* variables are injected at
# once and the DB connection lives in exactly one place.
#
# Applied idempotently by tasks/database.yml.
# =============================================================================
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: cividash-db-secret
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-db
    app.kubernetes.io/part-of: cividash
stringData:
  DB_CONNECTION: "{{ cividash_db_connection }}"
  DB_HOST: "{{ cividash_db_host }}"
  DB_PORT: "{{ cividash_db_port }}"
  DB_DATABASE: "{{ cividash_db_name }}"
  DB_USERNAME: "{{ cividash_db_user }}"
  DB_PASSWORD: "{{ cividash_db_password }}"
