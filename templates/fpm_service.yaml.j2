{#
  cividash-fpm Service: ClusterIP on :9000.
  The Service name MUST stay "cividash-fpm" so the baked nginx config in the
  cividash_web image (fastcgi_pass cividash-fpm:9000) resolves it in-cluster.
#}
apiVersion: v1
kind: Service
metadata:
  name: cividash-fpm
  labels:
    app.kubernetes.io/name: cividash-fpm
    app.kubernetes.io/part-of: cividash
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: cividash-fpm
  ports:
    - name: fastcgi
      port: 9000
      targetPort: 9000
