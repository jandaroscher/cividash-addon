{#
  cividash-web: Nginx front container (cividash_web image, baked public assets).
  - Serves static assets + proxies PHP to cividash-fpm:9000 (fastcgi, baked config).
  - Stateless: no app env / no secrets needed here (all dynamic work is on FPM).
  - Health via Laravel's GET /up endpoint (proxied through to FPM).
  - Pod security: the official nginx:alpine master runs as ROOT by design and
    needs a few caps (CHOWN/SETUID/SETGID to set up /var/cache/nginx and drop
    workers to the nginx user, NET_BIND_SERVICE to bind :80). Hardening to a
    fully non-root web tier (nginxinc/nginx-unprivileged, listen :8080) is a
    follow-up in the cividash-web image (WF3a).
#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cividash-web
  labels:
    app.kubernetes.io/name: cividash-web
    app.kubernetes.io/part-of: cividash
spec:
  replicas: {{ cividash_web_replicas | int }}
  selector:
    matchLabels:
      app.kubernetes.io/name: cividash-web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-web
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      # nginx:alpine master runs as root by design; non-root hardening
      # (nginxinc/nginx-unprivileged) is a follow-up in the cividash-web image (WF3a).
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: web
          image: "{{ cividash_web_image }}"
          imagePullPolicy: {{ cividash_image_pull_policy | default('Always') }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - NET_BIND_SERVICE  # bind :80
                - CHOWN             # nginx master chowns /var/cache/nginx at startup
                - SETUID            # spawn workers as the nginx user
                - SETGID
                - DAC_OVERRIDE
          ports:
            - name: http
              containerPort: 80
          readinessProbe:
            httpGet:
              path: /up
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /up
              port: 80
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
