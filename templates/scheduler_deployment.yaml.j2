{#
  cividash-scheduler: Laravel scheduler (cividash_app image, command override).
  - Runs the classic cron-emulation loop:
      while true; do php artisan schedule:run --no-interaction; sleep 60; done
  - STRICTLY 1 replica with strategy Recreate: the old pod must terminate
    before a new one starts so scheduled tasks never run on two pods at once.
  - No Service (background process, not network-addressable).
  - Same env contract as FPM/queue: app-secret + external-Postgres connection
    via envFrom cividash-db-secret.
  - emptyDir mounts for the per-pod writable Laravel dirs.
#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cividash-scheduler
  labels:
    app.kubernetes.io/name: cividash-scheduler
    app.kubernetes.io/part-of: cividash
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: cividash-scheduler
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-scheduler
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 82
        runAsGroup: 82
        fsGroup: 82
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: scheduler
          image: "{{ cividash_app_image }}"
          imagePullPolicy: {{ cividash_image_pull_policy | default('Always') }}
          securityContext:
            runAsNonRoot: true
            runAsUser: 82
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          command:
            - sh
            - -c
            - "while true; do php artisan schedule:run --no-interaction; sleep 60; done"
          # cividash-db-secret carries the full external-Postgres connection
          # (DB_CONNECTION/HOST/PORT/DATABASE/USERNAME/PASSWORD) in one place.
          envFrom:
            - secretRef:
                name: cividash-app-secret
            - secretRef:
                name: cividash-oidc-secret
            - secretRef:
                name: cividash-db-secret
