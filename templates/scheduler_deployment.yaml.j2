{#
  cividash-scheduler: Laravel scheduler (cividash_app image, command override).
  - Runs the classic cron-emulation loop:
      while true; do php artisan schedule:run --no-interaction; sleep 60; done
  - STRICTLY 1 replica with strategy Recreate: the old pod must terminate
    before a new one starts so scheduled tasks never run on two pods at once.
  - No Service (background process, not network-addressable).
  - Same env contract as FPM/queue: app-secret + DB creds via secretKeyRef.
  - emptyDir mounts for the per-pod writable Laravel dirs.
#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cividash-scheduler
  labels:
    app.kubernetes.io/name: cividash-scheduler
    app.kubernetes.io/part-of: cividash
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: cividash-scheduler
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-scheduler
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 82
        runAsGroup: 82
        fsGroup: 82
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: scheduler
          image: "{{ cividash_app_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 82
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          command:
            - sh
            - -c
            - "while true; do php artisan schedule:run --no-interaction; sleep 60; done"
          envFrom:
            - secretRef:
                name: cividash-app-secret
            - secretRef:
                name: cividash-oidc-secret
          env:
            - name: DB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_DATABASE
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_USER
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_PASSWORD
          volumeMounts:
            - name: storage-framework
              mountPath: /var/www/html/storage/framework
            - name: bootstrap-cache
              mountPath: /var/www/html/bootstrap/cache
      volumes:
        - name: storage-framework
          emptyDir: {}
        - name: bootstrap-cache
          emptyDir: {}
