{#
  cividash-queue: Laravel queue worker (cividash_app image, command override).
  - Runs "php artisan queue:work" (database queue driver).
  - --max-time=3600 recycles the worker hourly so a fresh process picks up
    new code/config; --tries=3 bounds retries.
  - Single replica, no Service (background worker, not network-addressable).
  - Same env contract as FPM: app-secret + individual DB creds via secretKeyRef.
  - emptyDir mounts for the per-pod writable Laravel dirs.
  - Liveness via exec pgrep so a wedged worker process gets restarted.
#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cividash-queue
  labels:
    app.kubernetes.io/name: cividash-queue
    app.kubernetes.io/part-of: cividash
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cividash-queue
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cividash-queue
        app.kubernetes.io/part-of: cividash
    spec:
{% if cividash_image_pull_secret %}
      imagePullSecrets:
        - name: "{{ cividash_image_pull_secret }}"
{% endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 82
        runAsGroup: 82
        fsGroup: 82
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: queue
          image: "{{ cividash_app_image }}"
          imagePullPolicy: {{ cividash_image_pull_policy | default('Always') }}
          securityContext:
            runAsNonRoot: true
            runAsUser: 82
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          command: ["php"]
          args:
            - artisan
            - queue:work
            - --tries=3
            - --max-time=3600
          envFrom:
            - secretRef:
                name: cividash-app-secret
            - secretRef:
                name: cividash-oidc-secret
          env:
            - name: DB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_DATABASE
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_USER
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cividash-db-secret
                  key: MARIADB_PASSWORD
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - pgrep -f "artisan queue:work" > /dev/null
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
