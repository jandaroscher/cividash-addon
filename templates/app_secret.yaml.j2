# =============================================================================
# Secret: cividash-app-secret — Laravel application environment + APP_KEY
# -----------------------------------------------------------------------------
# Holds APP_KEY (idempotent, preserved across runs) and all NON-DB app env.
# Consumed by cividash-fpm / cividash-queue / cividash-scheduler / cividash-migrate via envFrom.
#
# NOT stored here (sourced elsewhere, by design):
#   - DB_CONNECTION/HOST/PORT/DATABASE/USERNAME/PASSWORD -> cividash-db-secret (envFrom)
#   - KEYCLOAK_* / CIVITAS client-credentials  -> cividash-oidc-secret (written by keycloak_sso.yml)
# =============================================================================
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: cividash-app-secret
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: cividash-app
    app.kubernetes.io/part-of: cividash
stringData:
  # --- Core Laravel ---------------------------------------------------------
  APP_ENV: "production"
  APP_DEBUG: "false"
  APP_URL: "https://{{ inv_addons.cividash.public_host }}"
  APP_KEY: "{{ cividash_app_key }}"
  TRUSTED_PROXIES: "*"

  # --- Database connection --------------------------------------------------
  # The full DB connection (DB_CONNECTION/HOST/PORT/DATABASE/USERNAME/PASSWORD)
  # is single-sourced from cividash-db-secret (external Postgres) and injected into
  # the workloads via envFrom, so nothing DB-related is duplicated here.

  # --- Drivers (everything in the DB, per CONTRACT) -------------------------
  SESSION_DRIVER: "database"
  CACHE_STORE: "database"
  QUEUE_CONNECTION: "database"

  # --- Object storage (media via S3 / CORE RustFS) -------------------------
  # access_key_id / secret_access_key are sensitive and must be supplied by the
  # (vaulted) platform inventory under inv_addons.cividash.s3.*.
  PUBLIC_DISK_DRIVER: "s3"
  AWS_ACCESS_KEY_ID: "{{ inv_addons.cividash.s3.access_key_id }}"
  AWS_SECRET_ACCESS_KEY: "{{ inv_addons.cividash.s3.secret_access_key }}"
  AWS_DEFAULT_REGION: "{{ inv_addons.cividash.s3.region | default('us-east-1') }}"
  AWS_ENDPOINT: "{{ inv_addons.cividash.s3.endpoint }}"
  PUBLIC_S3_BUCKET: "{{ inv_addons.cividash.s3.bucket }}"
  FILESYSTEM_PUBLIC_URL: "{{ inv_addons.cividash.s3.public_url }}"

  # --- CIVITAS / NGSI-LD base config ---------------------------------------
  # Machine-token client-credentials + KEYCLOAK_* live in cividash-oidc-secret.
  CIVITAS_ENABLED: "true"
  CIVITAS_DRIVER: "ngsi-ld"
  CIVITAS_API_URL: "{{ inv_addons.cividash.civitas_api_url }}/context/ngsi-ld"
